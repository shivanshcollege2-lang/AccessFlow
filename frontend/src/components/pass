import React, { useState } from 'react';
import { createPassRequest } from '../../services/api';

const PassRequestForm = () => {
    const [destination, setDestination] = useState('');
    const [reason, setReason] = useState('');
    const [date, setDate] = useState('');
    const [error, setError] = useState('');
    const [success, setSuccess] = useState('');

    const handleSubmit = async (e) => {
        e.preventDefault();
        setError('');
        setSuccess('');

        try {
            const response = await createPassRequest({ destination, reason, date });
            if (response.status === 200) {
                setSuccess('Pass request created successfully!');
                setDestination('');
                setReason('');
                setDate('');
            }
        } catch (err) {
            setError('Failed to create pass request. Please try again.');
        }
    };

    return (
        <div>
            <h2>Create Pass Request</h2>
            {error && <p className="error">{error}</p>}
            {success && <p className="success">{success}</p>}
            <form onSubmit={handleSubmit}>
                <div>
                    <label>Destination:</label>
                    <input
                        type="text"
                        value={destination}
                        onChange={(e) => setDestination(e.target.value)}
                        required
                    />
                </div>
                <div>
                    <label>Reason:</label>
                    <textarea
                        value={reason}
                        onChange={(e) => setReason(e.target.value)}
                        required
                    />
                </div>
                <div>
                    <label>Date:</label>
                    <input
                        type="date"
                        value={date}
                        onChange={(e) => setDate(e.target.value)}
                        required
                    />
                </div>
                <button type="submit">Submit Request</button>
            </form>
        </div>
    );
};

export default PassRequestForm; 

